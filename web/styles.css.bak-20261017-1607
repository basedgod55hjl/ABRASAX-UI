/* ABRASAX gateway chat — no CDN, no build step. */
:root {
  --bg: #08080d;
  --panel: #101018;
  --panel-2: #15151f;
  --line: #23233a;
  --text: #d7d7e4;
  --muted: #7d7d94;
  --accent: #7c6cf0;
  --accent-soft: rgba(124, 108, 240, .14);
  --ok: #2ee6a0;
  --warn: #ffb020;
  --err: #ff5f6d;
  --radius: 12px;
  --mono: "Cascadia Mono", Consolas, "Courier New", monospace;
}

* { box-sizing: border-box; }

html, body {
  height: 100%;
  margin: 0;
}

body {
  display: flex;
  flex-direction: column;
  background: radial-gradient(1200px 600px at 50% -10%, #14142a 0%, var(--bg) 60%) fixed;
  color: var(--text);
  font: 14px/1.55 "Segoe UI", system-ui, -apple-system, sans-serif;
}

/* ---------- top bar ---------- */
.topbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 20px;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  background: linear-gradient(180deg, #12121f, #0d0d16);
  border-bottom: 1px solid var(--line);
}

.brand { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; flex: 0 1 auto; }
.brand-name { font-size: 17px; font-weight: 700; letter-spacing: 3px; color: #fff; }
.brand-hex { font: 11px var(--mono); color: var(--accent); letter-spacing: 1px; opacity: .85; }
.brand-sub { font-size: 11px; color: var(--muted); letter-spacing: 1.5px; text-transform: uppercase; }

.controls { display: flex; align-items: flex-end; gap: 8px; flex-wrap: wrap; flex: 1 1 auto; justify-content: flex-end; }
.field { display: flex; flex-direction: column; gap: 3px; flex: 0 0 auto; }
.field.grow { min-width: 200px; flex: 0 1 280px; }
.field-label { font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }

select, textarea, button { font: inherit; color: inherit; }

select {
  background: #0b0b13;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 7px 9px;
  min-width: 120px;
  width: 132px;
  max-width: 100%;
  outline: none;
}
.field.grow select { width: 100%; }
select:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
select:disabled { color: var(--muted); }

.btn {
  border: 1px solid var(--line);
  background: var(--panel-2);
  border-radius: 8px;
  padding: 7px 12px;
  cursor: pointer;
  transition: border-color .15s, background .15s, color .15s;
}
.btn:hover:not(:disabled) { border-color: var(--accent); color: #fff; }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn.ghost { color: var(--muted); }
.btn.send {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 600;
  min-width: 84px;
}
.btn.send:hover:not(:disabled) { background: #8d7ef7; }

/* ---------- telemetry strip ---------- */
.telemetry {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 10px;
  padding: 6px 18px;
  font: 12px var(--mono);
  color: var(--muted);
  background: #0b0b12;
  border-bottom: 1px solid var(--line);
}
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); flex: 0 0 auto; }
.dot.ok { background: var(--ok); box-shadow: 0 0 7px var(--ok); }
.dot.bad { background: var(--err); box-shadow: 0 0 7px var(--err); }
.dot.checking { background: var(--warn); box-shadow: 0 0 7px var(--warn); }
.tele { color: var(--text); }
.tele-sep { color: #34344a; }
.tele-detail { color: var(--err); flex: 1 1 240px; min-width: 0; overflow-wrap: anywhere; }

.banner {
  padding: 7px 18px;
  font: 12px var(--mono);
  color: #ffd7da;
  background: rgba(255, 95, 109, .12);
  border-bottom: 1px solid rgba(255, 95, 109, .35);
}

/* ---------- messages ---------- */
.messages {
  flex: 1 1 auto;
  overflow-y: auto;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  scrollbar-width: thin;
  scrollbar-color: #2a2a40 transparent;
}

.intro {
  margin: auto;
  max-width: 560px;
  text-align: center;
  color: var(--muted);
}
.intro h1 { font-size: 18px; font-weight: 600; color: #fff; margin: 10px 0 6px; }
.intro p { margin: 0 0 14px; font-size: 13px; }
.intro code { font-family: var(--mono); color: var(--text); font-size: 12px; }
.intro-hex { font: 13px var(--mono); letter-spacing: 4px; color: var(--accent); opacity: .6; }
.intro-facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 12px; }
.intro-facts span { display: inline-block; min-width: 56px; color: var(--accent); }

.msg { max-width: min(78ch, 88%); animation: in .18s ease-out; }
@keyframes in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }

.msg-head {
  display: flex; align-items: baseline; gap: 8px;
  font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase;
  color: var(--muted); margin-bottom: 4px;
}
.msg.user { align-self: flex-end; }
.msg.user .msg-head { justify-content: flex-end; }
.msg-body {
  padding: 10px 13px;
  border-radius: var(--radius);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  border: 1px solid transparent;
}
.msg.user .msg-body {
  background: #1b1b31;
  border-color: #2c2c4a;
  border-bottom-right-radius: 3px;
}
.msg.assistant .msg-body {
  background: var(--panel);
  border-color: var(--line);
  border-bottom-left-radius: 3px;
}
.msg.error .msg-body {
  background: rgba(255, 95, 109, .08);
  border-color: rgba(255, 95, 109, .45);
  color: #ffc9cd;
  font-family: var(--mono);
  font-size: 12px;
}
.msg-meta {
  margin-top: 5px;
  font: 10.5px var(--mono);
  color: var(--muted);
  display: flex; flex-wrap: wrap; gap: 4px 10px;
}
.msg-meta .bad { color: var(--err); }

.msg details {
  margin-top: 7px;
  border: 1px dashed #2c2c46;
  border-radius: 8px;
  padding: 6px 9px;
  font: 12px var(--mono);
  color: var(--muted);
}
.msg details summary { cursor: pointer; color: var(--accent); }

.msg.pending .msg-body { color: var(--muted); }
.typing { display: inline-flex; gap: 4px; vertical-align: middle; }
.typing i {
  width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
  animation: pulse 1.2s infinite ease-in-out;
}
.typing i:nth-child(2) { animation-delay: .15s; }
.typing i:nth-child(3) { animation-delay: .3s; }
@keyframes pulse { 0%, 80%, 100% { opacity: .3; transform: scale(.8); } 40% { opacity: 1; transform: scale(1.15); } }

/* ---------- composer ---------- */
.composer {
  border-top: 1px solid var(--line);
  background: #0c0c15;
  padding: 10px 18px 8px;
}
#chatForm { display: flex; gap: 8px; align-items: flex-end; }
#input {
  flex: 1 1 auto;
  resize: none;
  min-height: 42px;
  max-height: 180px;
  padding: 10px 12px;
  background: #0a0a12;
  border: 1px solid var(--line);
  border-radius: 10px;
  outline: none;
  line-height: 1.45;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: #2a2a40 transparent;
}
#input::-webkit-scrollbar { width: 8px; }
#input::-webkit-scrollbar-thumb { background: #2a2a40; border-radius: 4px; }
#input::-webkit-scrollbar-track { background: transparent; }
#input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
#input:disabled { opacity: .6; }
.composer-meta {
  display: flex; justify-content: space-between; gap: 10px;
  margin-top: 5px; font: 10.5px var(--mono); color: var(--muted);
}
.composer-endpoint { overflow-wrap: anywhere; text-align: right; }

@media (max-width: 620px) {
  .topbar { padding: 10px 12px; gap: 8px 10px; }
  .brand-sub { display: none; }
  .brand-hex { font-size: 10px; }
  .controls { flex: 1 0 100%; }
  .field, .field.grow { flex: 1 1 calc(50% - 5px); min-width: 0; }
  .field select, .field.grow select { width: 100%; max-width: none; }
  .messages { padding: 12px; }
  .msg { max-width: 96%; }
  .composer { padding: 8px 12px 6px; }
  .composer-endpoint { display: none; }
}
